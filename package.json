{
  "name": "alif-laam-meem-academy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"yarn dev:web\" \"yarn dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsx scripts/copy-email-templates-for-functions.ts && tsx scripts/generate-sitemap.ts && tsx scripts/generate-agentic-files.ts && vite build && tsx scripts/validate-seo-routes.ts && tsx scripts/validate-agentic-files.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "firebase": "^12.9.0",
    "lucide-react": "^0.574.0",
    "nodemailer": "^10.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-international-phone": "^4.8.0",
    "react-router-dom": "^7.13.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
