# Apache / LiteSpeed (Hostinger, cPanel). Every indexable route is a prerendered
# directory (e.g. /pricing/index.html), so there is no SPA catch-all: unknown
# URLs get a real 404 instead of the homepage with status 200 (soft 404).

ErrorDocument 404 /404.html
DirectoryIndex index.html
DirectorySlash On
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. One host, one protocol: https://aliflaammeeminstitute.online (no www).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

  # 2. Form APIs (PHP handlers) must come before any other rewrite.
  RewriteRule ^api/trial/?$ api/trial.php [L]
  RewriteRule ^api/contact/?$ api/contact.php [L]

  # 3. Old alias -> canonical page.
  RewriteRule ^register/?$ /book-free-trial/ [L,R=301]

  # 4. Drop index.html from URLs (/pricing/index.html -> /pricing/).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|jfif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
